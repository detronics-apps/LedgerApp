rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // No `email_verified` check here on purpose: accounts are provisioned only
    // by an admin (Firebase console > Authentication > Users > Add user, or
    // Auth is Google/Microsoft SSO), not self-service signup - the admin
    // vouches for who an email belongs to at account-creation time, so
    // self-verification via a clicked email link is not the security
    // boundary here the way it would be for open signup.
    function isCompanyUser() {
      return isSignedIn() &&
        request.auth.token.email.matches('.*@research-square[.]com$');
    }

    function isAdmin() {
      return isCompanyUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function computedPoints(data) {
      return data.impact * data.proof * data.taskWeight * data.categoryWeight;
    }

    function isValidEntry(data) {
      return data.uid is string &&
        data.impact is number && data.impact >= 1 && data.impact <= 5 &&
        data.proof is number && data.proof >= 1 && data.proof <= 3 &&
        data.taskWeight is number && data.taskWeight > 0 &&
        data.categoryWeight is number && data.categoryWeight > 0 &&
        data.points == computedPoints(data);
    }

    // An admin re-linking a custom ("Other") entry to a real task: only the
    // categorization fields (category/task id+name, isCustomTask, weights,
    // points) may change - the employee's own uid, impact, proof,
    // description, evidence, and date must come through untouched. This is
    // strictly narrower than a normal edit: it can only ever start from an
    // isCustomTask entry and land on isCustomTask == false, never touch
    // someone's actual assessment of what they did.
    function isRecategorizationOnly(before, after) {
      return before.uid == after.uid &&
        before.impact == after.impact &&
        before.proof == after.proof &&
        before.description == after.description &&
        before.evidenceUrl == after.evidenceUrl &&
        before.date == after.date &&
        before.isCustomTask == true &&
        after.isCustomTask == false &&
        isValidEntry(after);
    }

    // An admin marking an entry as validated (see settings.managementValidation):
    // only `validated`/`validatedAt`/`validatedBy` may change. This never
    // touches impact/proof/points/category/task - validation is an
    // acknowledgement, not a re-scoring.
    function isValidationOnly(before, after) {
      return before.uid == after.uid &&
        before.impact == after.impact &&
        before.proof == after.proof &&
        before.points == after.points &&
        before.categoryId == after.categoryId &&
        before.taskId == after.taskId &&
        before.isCustomTask == after.isCustomTask &&
        before.description == after.description &&
        before.evidenceUrl == after.evidenceUrl &&
        before.date == after.date;
    }

    match /entries/{entryId} {
      allow read: if isCompanyUser();
      allow create: if isCompanyUser() &&
        request.resource.data.uid == request.auth.uid &&
        isValidEntry(request.resource.data);
      allow update: if isCompanyUser() && (
        (resource.data.uid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          isValidEntry(request.resource.data)) ||
        (isAdmin() && isRecategorizationOnly(resource.data, request.resource.data)) ||
        (isAdmin() && isValidationOnly(resource.data, request.resource.data))
      );
      allow delete: if isCompanyUser() && resource.data.uid == request.auth.uid;
    }

    match /categories/{categoryId} {
      allow read: if isCompanyUser();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isCompanyUser();
      allow write: if isAdmin();
    }

    // An admin toggling someone's R&R-exclusion flag (settings.rrExclusion):
    // only `excludedFromLedger` may change - an admin still can't touch a
    // user's own email/displayName via this path.
    function isExclusionFlagOnly(before, after) {
      return before.email == after.email && before.displayName == after.displayName;
    }

    // Every company user can read the directory (names are already visible on
    // every ledger entry, so this adds no new exposure) but may only write
    // their own profile doc - except an admin may flip the exclusion flag on
    // someone else's doc (see isExclusionFlagOnly above).
    match /users/{userId} {
      allow read: if isCompanyUser();
      allow create, update: if isCompanyUser() && request.auth.uid == userId;
      allow update: if isAdmin() && isExclusionFlagOnly(resource.data, request.resource.data);
      allow delete: if false;
    }

    // A single shared settings document. Any company user can read it (the
    // app needs it to know which limits are currently on); only an admin can
    // change it. See README "Known limitations" - the caps here are enforced
    // in this app's own JS, not re-checked against these values in rules, so
    // they are a guide for honest use, not a hard security boundary yet.
    match /settings/{settingsId} {
      allow read: if isCompanyUser();
      allow write: if isAdmin();
    }

    // An existing admin may grant admin access to someone who has already
    // signed in at least once (their users/{uid} doc must exist, and the
    // granted email must match that doc's email exactly - an admin can't
    // mislabel who they're granting access to). There is no update or
    // delete: an admin doc, once created, can never be edited or removed
    // by any client - de-admin-ing someone is a manual Firebase-console
    // step (see README), same as bootstrapping the very first admin
    // (nobody can grant admin before at least one admin exists).
    match /admins/{uid} {
      allow read: if isCompanyUser() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        request.resource.data.email == get(/databases/$(database)/documents/users/$(uid)).data.email;
      allow update, delete: if false;
    }
  }
}
