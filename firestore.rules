rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // No `email_verified` check here on purpose: accounts are provisioned only
    // by an admin (Firebase console > Authentication > Users > Add user, or
    // Auth is Google/Microsoft SSO), not self-service signup - the admin
    // vouches for who an email belongs to at account-creation time, so
    // self-verification via a clicked email link is not the security
    // boundary here the way it would be for open signup.
    function isCompanyUser() {
      return isSignedIn() &&
        request.auth.token.email.matches('.*@research-square[.]com$');
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    // A full admin: has an admins/{uid} doc with no categoryIds restriction
    // (missing, or an empty list). Full admins can touch everything -
    // settings, validation, other admins - not just categories/tasks.
    function isAdmin() {
      return isCompanyUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        (!('categoryIds' in adminData()) || adminData().categoryIds.size() == 0);
    }

    // A category-scoped admin: has an admins/{uid} doc whose categoryIds
    // lists this specific category. Scoped admins can only touch their own
    // categories/tasks - never settings, validation, users, or other admins.
    function isCategoryAdminFor(categoryId) {
      return isCompanyUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        ('categoryIds' in adminData()) &&
        categoryId in adminData().categoryIds;
    }

    function computedPoints(data) {
      return data.impact * data.proof * data.taskWeight * data.categoryWeight;
    }

    function isValidEntry(data) {
      return data.uid is string &&
        data.impact is number && data.impact >= 1 && data.impact <= 5 &&
        data.proof is number && data.proof >= 1 && data.proof <= 3 &&
        data.taskWeight is number && data.taskWeight > 0 &&
        data.categoryWeight is number && data.categoryWeight > 0 &&
        data.points == computedPoints(data);
    }

    // An admin re-linking a custom ("Other") entry to a real task: only the
    // categorization fields (category/task id+name, isCustomTask, weights,
    // points) may change - the employee's own uid, impact, proof,
    // description, evidence, and date must come through untouched. This is
    // strictly narrower than a normal edit: it can only ever start from an
    // isCustomTask entry and land on isCustomTask == false, never touch
    // someone's actual assessment of what they did.
    function isRecategorizationOnly(before, after) {
      return before.uid == after.uid &&
        before.impact == after.impact &&
        before.proof == after.proof &&
        before.description == after.description &&
        before.evidenceUrl == after.evidenceUrl &&
        before.date == after.date &&
        before.isCustomTask == true &&
        after.isCustomTask == false &&
        isValidEntry(after);
    }

    // An admin marking an entry as validated (see settings.managementValidation):
    // only `validated`/`validatedAt`/`validatedBy` may change. This never
    // touches impact/proof/points/category/task - validation is an
    // acknowledgement, not a re-scoring.
    function isValidationOnly(before, after) {
      return before.uid == after.uid &&
        before.impact == after.impact &&
        before.proof == after.proof &&
        before.points == after.points &&
        before.categoryId == after.categoryId &&
        before.taskId == after.taskId &&
        before.isCustomTask == after.isCustomTask &&
        before.description == after.description &&
        before.evidenceUrl == after.evidenceUrl &&
        before.date == after.date;
    }

    match /entries/{entryId} {
      allow read: if isCompanyUser();
      allow create: if isCompanyUser() &&
        request.resource.data.uid == request.auth.uid &&
        isValidEntry(request.resource.data);
      allow update: if isCompanyUser() && (
        (resource.data.uid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          isValidEntry(request.resource.data)) ||
        (isAdmin() && isRecategorizationOnly(resource.data, request.resource.data)) ||
        (isAdmin() && isValidationOnly(resource.data, request.resource.data))
      );
      // A full admin ("All categories" when granting access) may delete any
      // entry - e.g. a mistaken or duplicate log - in addition to an
      // employee deleting their own. Deliberately NOT extended to
      // category-scoped admins: deletion is destructive in a way editing
      // isn't, so it's reserved for admins with access to every category,
      // not just their own. This is also a deliberate policy choice on its
      // own terms: the ledger's earlier "not even an admin can delete" rule
      // traded away correctability for tamper-evidence, and this pilot
      // wants the former.
      allow delete: if isCompanyUser() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /categories/{categoryId} {
      allow read: if isCompanyUser();
      // A scoped admin can only ever touch a category already in their
      // categoryIds list - a freshly-created category gets a random id that
      // can't already be in that list, so scoped admins can edit their own
      // categories but never create new ones.
      allow write: if isAdmin() || isCategoryAdminFor(categoryId);
    }

    match /tasks/{taskId} {
      allow read: if isCompanyUser();
      allow create: if isAdmin() || isCategoryAdminFor(request.resource.data.categoryId);
      allow update: if isAdmin() ||
        (isCategoryAdminFor(resource.data.categoryId) && isCategoryAdminFor(request.resource.data.categoryId));
      allow delete: if isAdmin() || isCategoryAdminFor(resource.data.categoryId);
    }

    // Every company user can read the directory (names are already visible on
    // every ledger entry, so this adds no new exposure) but may only write
    // their own profile doc.
    match /users/{userId} {
      allow read: if isCompanyUser();
      allow create, update: if isCompanyUser() && request.auth.uid == userId;
      allow delete: if false;
    }

    // A single shared settings document. Any company user can read it (the
    // app needs it to know which limits are currently on); only an admin can
    // change it. See README "Known limitations" - the caps here are enforced
    // in this app's own JS, not re-checked against these values in rules, so
    // they are a guide for honest use, not a hard security boundary yet.
    match /settings/{settingsId} {
      allow read: if isCompanyUser();
      allow write: if isAdmin();
    }

    // An existing full admin may grant admin access to someone who has
    // already signed in at least once (their users/{uid} doc must exist, and
    // the granted email must match that doc's email exactly - an admin can't
    // mislabel who they're granting access to), and may revoke anyone else's
    // admin access (never their own - no self-lockout; bootstrapping the
    // very first admin is still a manual Firebase-console step, since nobody
    // can grant admin before at least one admin exists). There is no update:
    // an admin doc's access level is changed by revoking and re-granting,
    // never edited in place.
    match /admins/{uid} {
      allow read: if isCompanyUser() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        request.resource.data.email == get(/databases/$(database)/documents/users/$(uid)).data.email;
      allow update: if false;
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // One person can re-flag the same entry only once their own last flag on
    // it was resolved (updated/rejected) - never on top of one of their own
    // still-open ones. Different people each get their own independent flag
    // (that's what lets the admin queue count "flagged by N people").
    function isFlagResubmission(before, after) {
      return before.entryId == after.entryId &&
        before.categoryId == after.categoryId &&
        before.flaggedBy == after.flaggedBy &&
        after.status == 'open' &&
        (before.status == 'updated' || before.status == 'rejected');
    }

    // An admin (full, or category-scoped for that flag's own category)
    // moving a flag through its states - only status may change.
    function isFlagStatusUpdate(before, after) {
      return before.entryId == after.entryId &&
        before.categoryId == after.categoryId &&
        before.flaggedBy == after.flaggedBy &&
        before.reason == after.reason &&
        after.status in ['under-review', 'updated', 'rejected'];
    }

    // A colleague flagging someone else's entry for a second look (see
    // js/flags.js) - "not to snitch on each other, but to help each other be
    // fair and catch mistakes". Deliberately its own collection rather than
    // fields on the entry: that's what lets more than one person flag the
    // same entry independently, so the admin queue can show a headcount
    // instead of a single overwritten flag. Every company user may read (the
    // app's own UI is what keeps a flag's existence and who raised it from
    // reaching anyone but admins and the person who raised it - see README
    // "Known limitations").
    match /flags/{flagId} {
      allow read: if isCompanyUser();
      allow create: if isCompanyUser() &&
        request.resource.data.flaggedBy == request.auth.uid &&
        request.resource.data.status == 'open' &&
        get(/databases/$(database)/documents/entries/$(request.resource.data.entryId)).data.uid != request.auth.uid;
      allow update: if isCompanyUser() && (
        (resource.data.flaggedBy == request.auth.uid && isFlagResubmission(resource.data, request.resource.data)) ||
        ((isAdmin() || isCategoryAdminFor(resource.data.categoryId)) && isFlagStatusUpdate(resource.data, request.resource.data))
      );
      allow delete: if false;
    }
  }
}
